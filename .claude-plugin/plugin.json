  "author": { "name": "Paavu", "url": "https://github.com/paavu" },
  "homepage": "https://github.com/paavu/flowdeck-mod",
  "repository": "https://github.com/paavu/flowdeck-mod",
  "license": "MIT",
  "keywords": ["mod", "orchestration", "subagents", "workflow", "progress", "agents-panel", "context", "usage-limits", "prompt-cache", "keep-warm", "archive"],
  "icon": "./.claude-plugin/icon.png",
  "documentationUrl": "https://github.com/paavu/flowdeck-mod#readme",
  "supportUrl": "https://github.com/paavu/flowdeck-mod/issues",
  "privacyPolicyUrl": "https://github.com/paavu/flowdeck-mod#privacy-what-it-reads-writes-and-runs",
  "types": "./types/index.d.ts",
  "userConfig": {
    "language": {
      "type": "string",
      "title": "Panel language",
      "description": "auto follows Claude Code's language setting, then the system locale",
      "default": "auto",
      "options": ["auto", "en", "ru"]
    }
  }
}
